# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAX_RESUMES_PER_ANALYSIS=100
NEXT_PUBLIC_UPLOAD_CONCURRENCY=4
MAX_RESUMES_PER_ANALYSIS=100

# Supabase (use the publishable key for new projects; anon remains a compatibility fallback)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — server only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# OpenAI — server only; ranking never comes from the language model
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EXPLANATION_MODEL=
OPENAI_RAG_MODEL=gpt-5-mini

# OCR — server only; scanned PDFs use the configured OpenAI model
OCR_PROVIDER=openai
